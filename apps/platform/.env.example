# Kopiera till .env och fyll i. Filen .env checkas aldrig in.
# Plattformen VÄGRAR starta om något värde saknas eller är ogiltigt.

# Domänen för byggverktyg, inloggning och förhandsvisningar (p-<app-id>.<BASE_DOMAIN>).
BASE_DOMAIN=example.org

# Domänen för publicerade appar (<app-id>.<APP_DOMAIN>). Samma som BASE_DOMAIN enligt ADR 0002;
# egen inställning så att apparna kan flyttas till en egen domän utan kodändring.
APP_DOMAIN=example.org

# Absolut sökväg. Här hamnar appregistret, apparnas byggda filer och apparnas data.
DATA_DIR=/var/lib/vibesandbox

PORT=8787

# Standard är 127.0.0.1: plattformen ska stå bakom en omvänd proxy som sköter TLS.
LISTEN_HOST=127.0.0.1

# Schemat och porten webbläsaren ser (TLS avslutas i proxyn framför plattformen). Avgör alla
# adresser plattformen ger ut, byggverktygets origin (https://bygg.<BASE_DOMAIN>) och kakornas namn.
# PUBLIC_PORT är valfri: tom = schemats standardport (443 för https, 80 för http).
PUBLIC_SCHEME=https
PUBLIC_PORT=

# ── Inloggning ───────────────────────────────────────────────────────────────────────────────
# email-otp: engångskod via mejl, bara för inbjudna adresser (drift).
# test:      testinloggning för utveckling. Vägrar starta när NODE_ENV=production.
IDENTITY_PROVIDER=email-otp

# email-otp: nyckel för sessioner och koder. Minst 32 byte, inget standardvärde. Skapa ett eget:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Byts den blir alla sessioner och koder ogiltiga.
IDENTITY_SECRET=

# email-otp: mejl via Mailgun (EU). Alla tre, eller inget av dem.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.org
MAIL_FROM=Vibesandbox <noreply@example.org>

# email-otp, BARA utanför produktion: i stället för Mailgun skrivs mejlen (med koderna) som filer
# i den här katalogen. Absolut sökväg. Sätt inte både Mailgun och den här.
# MAIL_OUTBOX_DIR=/tmp/vibesandbox-utkorg

# test: minst 32 byte, inget standardvärde (se kommandot ovan).
TEST_IDENTITY_SECRET=

# Adressen till den som driver plattformen. Dit mejlas återkoppling PÅ BYGGVERKTYGET, tillsammans
# med konversationen om appen. Valfri — men utan den finns ingen mottagare, och återkopplingen
# skrivs då som filer i <DATA_DIR>/aterkoppling i stället för att skickas.
PLATFORM_OWNER_EMAIL=

# ── Byggverktyget ────────────────────────────────────────────────────────────────────────────
# Påslaget när LLM_MODEL är satt; då måste resten nedan också vara rätt, annars startar inget.
# Lämna LLM_MODEL tom för att köra utan byggverktyg.
LLM_BASE_URL=https://api.berget.ai/v1
LLM_MODEL=
# low, medium eller high. Sätt den: leverantörens standard är ofta högsta nivån.
LLM_REASONING_EFFORT=low
# Nyckeln till språkmodellen. BERGET_API_KEY godtas som alias (sätt bara den ena).
LLM_API_KEY=

# Hur appar byggs: docker, spool (jobb läggs i BUILD_JOBS_DIR och byggs av en separat byggare)
# eller local (direkt på värden, utan sandlåda — vägras när NODE_ENV=production).
BUILD_DRIVER=spool
BUILD_JOBS_DIR=/var/lib/vibesandbox-jobb

# Byggverktygets webbgränssnitt. Tom = apps/builder-ui/dist i repot
# (npm run build -w @vibesandbox/builder-ui).
BUILDER_UI_DIR=
