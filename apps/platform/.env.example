# Kopiera till .env och fyll i. Filen .env checkas aldrig in.
# Plattformen VÄGRAR starta om något värde saknas eller är ogiltigt.

# Domänen för byggverktyg, inloggning och förhandsvisningar (p-<app-id>.<BASE_DOMAIN>).
BASE_DOMAIN=example.org

# Domänen för publicerade appar (<app-id>.<APP_DOMAIN>). Samma som BASE_DOMAIN enligt ADR 0002;
# egen inställning så att apparna kan flyttas till en egen domän utan kodändring.
APP_DOMAIN=example.org

# Absolut sökväg. Här hamnar appregistret, apparnas byggda filer och apparnas data.
DATA_DIR=/var/lib/vibesandbox

PORT=8787

# Standard är 127.0.0.1: plattformen ska stå bakom en omvänd proxy som sköter TLS.
LISTEN_HOST=127.0.0.1

# Enda värdet tills e-postinloggningen finns: test. Vägrar starta när NODE_ENV=production.
IDENTITY_PROVIDER=test

# Minst 32 byte, och det finns inget standardvärde. Skapa ett eget:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
TEST_IDENTITY_SECRET=
